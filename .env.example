# pembroke.goodbotai.tech — required environment variables
#
# Set these on Vercel for each environment (Preview + Production).
# NEVER commit real values to git. This file is the documentation only;
# actual secrets live in the Vercel dashboard.

# ─── Clerk (auth) ───────────────────────────────────────────────────────
# From https://dashboard.clerk.com → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Optional: signing keys for sessions in Clerk dashboard. Auto-generated.

# ─── Vercel Postgres ────────────────────────────────────────────────────
# Provisioned via the Vercel dashboard → Storage → Postgres.
# Auto-creates POSTGRES_URL etc. when you attach the DB to the project.
POSTGRES_URL=postgres://default:xxxx@yyyy-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb

# ─── Resend (transactional email) ───────────────────────────────────────
# From https://resend.com/api-keys.
RESEND_API_KEY=re_replace_me

# Optional — override the default from-address and site URL used in emails.
# ALERT_FROM_EMAIL="Pembroke Town Brief <brief@pembroke.goodbotai.tech>"
# SITE_BASE_URL=https://pembroke.goodbotai.tech

# ─── Ask-the-bot LLM (Nous Research) ───────────────────────────────────
# Optional. Without it, /api/ask falls back to a context-aware stub.
# NOUS_API_KEY=sk-ant-... or nous-provided
# NOUS_MODEL=Hermes-4-405B
# NOUS_API_URL=https://inference-api.nousresearch.com/v1/chat/completions

# ─── Alert webhook (cron → site) ────────────────────────────────────────
# Generate via: openssl rand -hex 32
# Set the SAME value on Tyler's Mac cron AND on Vercel.
ALERT_WEBHOOK_SECRET=replace_with_64_hex_chars

# ─── Public site URL (for email links) ──────────────────────────────────
# Vercel sets this automatically on each deploy for server-side fetches,
# but for absolute URLs in outbound email we want a stable value.
NEXT_PUBLIC_SITE_URL=https://pembroke.goodbotai.tech